# 백엔드 환경변수 예시 — 실제 값은 .env 로 복사해 채우고 커밋하지 않는다.

# JWT 서명 비밀키 (32바이트 이상 권장)
JWT_SECRET=change-me-to-a-long-random-secret

# 네이버 Directions API (정식 전환 시)
NAVER_DIRECTIONS_KEY_ID=
NAVER_DIRECTIONS_KEY=

# 운영(prod) 프로파일용 — 로컬(local)에서는 application.yml 기본값 사용
DB_URL=jdbc:postgresql://localhost:15432/schoolbus
DB_USERNAME=schoolbus
DB_PASSWORD=schoolbus
REDIS_HOST=localhost
REDIS_PORT=16379
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

