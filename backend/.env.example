# 백엔드 환경변수 예시 — 실제 값은 .env 로 복사해 채우고 커밋하지 않는다. (저장소가 공개라 키 값을 여기 적지 않는다)

# JWT 서명 비밀키 (32바이트 이상 권장)
JWT_SECRET=change-me-to-a-long-random-secret

# 네이버 지도 API — 경로(Directions) · 주소 변환(Geocoding) 공용 NCP 애플리케이션 키.
# application.yml 이 이 이름을 우선하고, 없으면 옛 이름 NAVER_DIRECTIONS_KEY_ID / NAVER_DIRECTIONS_KEY 로 폴백한다.
# 옛 이름의 .env 를 그대로 쓰는 중이면 아래 두 줄은 지운다(빈 값이 폴백을 가린다).
NAVER_MAPS_KEY_ID=
NAVER_MAPS_KEY=

# 네이버 장소 이름 검색(주소 자동완성 보조) — NAVER API HUB 애플리케이션 키. 지도 키와 따로 받는다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Directions 5 전환 — Directions 15 일일 한도가 바닥났을 때만 채운다. 둘은 짝이라 하나만 바꾸지 않는다.
# 빈 값으로 두면 안 된다(빈 문자열이 기본값을 덮는다) — 쓸 때만 줄의 # 을 지우고, 안 쓰면 그대로 둔다.
# NAVER_DIRECTIONS_PATH=/map-direction/v1/driving
# NAVER_DIRECTIONS_MAX_POINTS=7

# 운영(prod) 프로파일용 — 로컬(local)에서는 application.yml 기본값 사용
DB_URL=jdbc:postgresql://localhost:15432/schoolbus
DB_USERNAME=schoolbus
DB_PASSWORD=schoolbus
REDIS_HOST=localhost
REDIS_PORT=16379
