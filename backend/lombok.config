# Lombok 설정 — backend 모듈 루트.
#
# stopBubbling: Lombok 은 소스 파일 위치에서 파일시스템 루트까지 거슬러 올라가며 lombok.config 를
# 합친다. 현재 상위(저장소 루트·홈·/)에는 아무 설정도 부재하나, 나중에 누군가 상위에 파일을 두면
# 이 모듈의 생성 코드가 조용히 달라진다. 여기서 끊어 backend 의 생성 규칙을 이 파일 하나로 고정한다.
config.stopBubbling = true

# copyableAnnotations: @RequiredArgsConstructor 가 만드는 생성자 파라미터로 복사할 애너테이션.
# final 필드는 필드 주입이 불가능하므로 @Value 가 생성자 파라미터까지 따라가야 값이 주입된다.
# 이 줄이 없으면 LoginCommandService·RefreshCommandService 의 refreshValiditySeconds 가 0,
# WebSocketConfig 의 allowedOriginPatterns 가 null 로 들어간다 — 컴파일은 통과한다.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
