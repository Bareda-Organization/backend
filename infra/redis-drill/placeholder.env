# Redis 멈춤 연습(infra/scripts/check-redis-outage.sh)용 자리표시자 — 값은 전부 가짜다. 실제 비밀값은 여기에 적지 않는다.
# 이 파일은 `docker compose config` 가 필수 변수 누락으로 멈추지 않게 하고, 연습 스택의 DB 비밀번호로만 쓰인다(컨테이너는 연습 뒤 지워진다).
ECR_REGISTRY=local-check.invalid
IMAGE_TAG=local-check
DB_PASSWORD=local-check-db-password
JWT_SECRET=local-check-only-jwt-secret-not-a-real-key-32bytes
SEED_PASSWORD_HASH=$$2a$$10$$Noeszx0nzJUfNo4ubCD03eNfMVfMD9feMo04y/8DHiFLUBF.JZ/Fq
CORS_ALLOWED_ORIGINS=https://app.local-check.invalid
WS_ALLOWED_ORIGIN_PATTERNS=https://app.local-check.invalid
SPRING_PROFILES_ACTIVE=demo
GRAFANA_ADMIN_PASSWORD=local-check-grafana-password
