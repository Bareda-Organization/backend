# OS
.DS_Store

# IDE
.idea/
*.iml

# Claude Code 작업 자료 (2026-09-09 전면 제외 → 2026-09-18 3개만 뒤집음)
# Orca 가 만드는 자식 워크트리는 git 이 추적하는 파일만 체크아웃한다. 지시서·사실 노트·
# 프로젝트 설정이 미추적이면 워크트리에서 뜬 에이전트가 빌드 명령(-PtestDbUrl 필수)도,
# Docker 포트도, Flyway 재구성 정책도 모르는 채 시작한다. 이 3개만 추적하고
# 라운드별 작업 기록·에이전트 정의는 그대로 제외한다.
.claude/*
!.claude/PROJECT_NOTES.md
!.claude/settings.json
# 손으로 쓴 프로젝트 스킬만 추적한다 — 워크트리에서 뜬 에이전트가 읽어야 한다
# (CLAUDE.md "git 추적 범위" 와 같은 근거). 도구가 설치한 스킬(playwright-cli 등)은
# 재생성되므로 제외 — 아래 예외 한 줄이 그 경계다.
!.claude/skills/
.claude/skills/*
!.claude/skills/baraeda-screen-check/
!.claude/skills/orca-launch/
# .superpowers/ 는 2026-09-20 에 삭제했다 — 그 작업 방식이 ECC·Orca·Skill 로 흡수됐고
# 정본이 근거로 쓰던 24개는 docs/archive/sdd/ 로 옮겨 추적 대상이 됐다

# tokensave local cache db
.tokensave/
**/.tokensave/

# Backend (Gradle / Spring Boot)
backend/build/
backend/.gradle/
backend/out/
backend/HELP.md
!backend/gradle/wrapper/gradle-wrapper.jar
backend/.env

# 스테이징(집 PC) — 비밀값 파일과 APK 내려받기 폴더(docker-compose.staging.yml)
/.env
/downloads/

# 배포 (운영 시크릿 — 커밋 금지)
# Swagger UI basic auth 계정 파일. 작업 트리에 만들지 않고 EC2 에서 직접 생성한다
# (절차: docs/infra/DEPLOYMENT.md §2.12). 실수로 만들어졌을 때를 대비해 여기서도 막아 둔다.
infra/proxy/.htpasswd

# 프론트엔드 — 2026-09-09 재개. 2026-09-09 사용자 결정으로 다시 추적한다
# (범위 밖 확정이던 Ruling 255 를 뒤집음). 관계자 웹은 Next.js, 학부모·매니저 앱은 Flutter.
# 소스와 디자인 시스템은 추적하고 빌드 산출물만 제외한다.
frontend/**/node_modules/
frontend/**/.next/
frontend/**/out/
frontend/**/.turbo/
frontend/**/build/
frontend/**/.dart_tool/
frontend/**/.flutter-plugins
frontend/**/.flutter-plugins-dependencies
frontend/**/*.iml
frontend/**/.env
frontend/**/.env.local

# Root — 앱 동작과 무관한 도구 의존성
node_modules/
/package.json
/package-lock.json

# 문서 — Markdown 정본만 추적한다 (2026-09-02 전면 제외 → 2026-09-18 뒤집음)
# 뒤집은 이유: 워크트리 에이전트가 사양 없이 시작하는 것을 막는다. 절대 경로를 주는
# 옛 방식은 워크트리마다 지시를 반복해야 하고 한 번 빠뜨리면 조용히 어긋난다.
# 사람용 렌더(HTML·PDF·PNG)와 기획 원본 .docx 는 파생본·바이너리라 계속 제외한다
# — md 26개(1.5MB)만 들어가고 비-md 64개(9.6MB)는 로컬에 그대로 남는다.
**/docs/**
!**/docs/**/
!**/docs/**/*.md

# 보고서 · 부하 측정 산출물 — 기록물이라 앱 동작과 무관하다
/report/
backend/report/
backend/load/results/
# 화면 확인 스크린샷(메인 저장소 frontend/report/<라운드>/) · 도구가 만드는 .playwright/ — 36MB 안팎이라 실수로 공개 저장소에 올라가지 않게 한다
frontend/report/
/.playwright/

# 문서 그래프 색인 — 파생본, 정본은 docs/ (규칙 ~/.claude/rules/docgraph.md)
.docgraph/

# Flutter — 패키지 잠금·생성물
frontend/**/.packages
frontend/**/pubspec.lock
frontend/**/*.g.dart
frontend/**/*.freezed.dart

# graft — 코드 구조 그래프 (재생성 가능한 로컬 캐시, tokensave 와 같은 성질)
graft/
.mcp.json
.ignore
# Playwright CLI output (may contain credentials)
.playwright-cli/
# 운영 Alertmanager 설정 — deploy.sh 가 SSM 값(봇 토큰·SMTP 비밀번호)으로 만든다. 로컬에서 시험하다 커밋하지 않게 막는다.
/alertmanager/
